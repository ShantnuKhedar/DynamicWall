<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Run in Apple's App Sandbox: the app can only touch what's listed here. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Outgoing HTTPS to Bing / Microsoft image servers. No incoming connections. -->
    <key>com.apple.security.network.client</key><true/>
    <!-- Read-only access to folders the user picks for the slideshow, remembered across launches. -->
    <key>com.apple.security.files.user-selected.read-only</key><true/>
    <key>com.apple.security.files.bookmarks.app-scope</key><true/>
    <!-- Save pictures into ~/Pictures/DynamicWall. -->
    <key>com.apple.security.assets.pictures.read-write</key><true/>
</dict>
</plist>
